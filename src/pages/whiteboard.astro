---
import Base from '../layouts/Base.astro';
import boards from '../content/whiteboard.json';

const base = import.meta.env.BASE_URL;
---

<Base title="Whiteboard" description="Sarah Blachly's whiteboard — doodles, notes, and dreams, straight from the studio.">
  <section class="fade-in" style="text-align:center; padding: 2rem 0;">
    <h1>Whiteboard</h1>
    <p style="color: var(--text-dim); max-width: 560px; margin: 0 auto;">
      <em>Doodles, notes, and half-dreams — pinned straight from my studio board.</em>
    </p>
  </section>

  {boards.length === 0 ? (
    <p style="text-align:center; color: var(--text-dim);">
      <em>The board is still blank — check back soon.</em>
    </p>
  ) : (
    <div style="display:flex; flex-direction:column; gap:2.5rem; max-width:860px; margin:0 auto;">
      {boards.map((b) => (
        <figure class="fade-in" style="margin:0;">
          <img
            src={`${base}/${b.image}`}
            alt={`Whiteboard post from ${b.postedAt}`}
            style="width:100%; border-radius:12px; border:1px solid rgba(168,216,255,0.2); box-shadow: 0 0 60px rgba(168,216,255,0.08);"
            loading="lazy"
          />
          <figcaption style="color: var(--text-dim); font-size:0.9rem; margin-top:0.5rem; text-align:center;">
            {b.postedAt}
          </figcaption>
        </figure>
      ))}
    </div>
  )}
</Base>
