---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import fs from 'node:fs';

export async function getStaticPaths() {
  const artworks = await getCollection('artworks');
  return artworks.map((a) => ({
    params: { slug: a.id.replace(/\.md$/, '') },
    props: { artwork: a },
  }));
}

const { artwork } = Astro.props;
const { title, year, medium, dimensions, description, alt } = artwork.data;
const img = artwork.data.image;
const base = import.meta.env.BASE_URL;
const hasSignature = fs.existsSync('public/images/studio/signature.png');
import siteSettings from '../../content/settings/site.json';
const sig = siteSettings.signature || { position: 'bottom-right', size: 160 };
const SIG_POS = {
  'top-left': 'top:4%;left:4%;',
  'top-center': 'top:4%;left:50%;transform:translateX(-50%);',
  'top-right': 'top:4%;right:4%;',
  'middle-left': 'top:50%;left:4%;transform:translateY(-50%);',
  'center': 'top:50%;left:50%;transform:translate(-50%,-50%);',
  'middle-right': 'top:50%;right:4%;transform:translateY(-50%);',
  'bottom-left': 'bottom:4%;left:4%;',
  'bottom-center': 'bottom:4%;left:50%;transform:translateX(-50%);',
  'bottom-right': 'bottom:4%;right:4%;',
};
const sigStyle = `position:absolute;${SIG_POS[sig.position] || SIG_POS['bottom-right']}max-width:${sig.size || 160}px;opacity:0.92;filter:drop-shadow(0 2px 6px rgba(0,0,0,0.55));pointer-events:none;`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "VisualArtwork",
  "name": title,
  "dateCreated": String(year),
  "artMedium": medium || undefined,
  "description": description || undefined,
  "creator": { "@id": "https://worldlinemuse-lgtm.github.io/sarah-blachly-art/#artist" },
  "image": /^https?:\/\//.test(img.src) ? img.src : `https://worldlinemuse-lgtm.github.io${img.src.startsWith('/') ? img.src : '/' + img.src}`,
  "url": `https://worldlinemuse-lgtm.github.io/sarah-blachly-art/work/${artwork.id.replace(/\.md$/, '')}/`,
};
const ogImage = jsonLd.image;
---

<Base title={title} description={description || `${title} (${year}) by Sarah Blachly.`} ogImage={ogImage} ogType="article">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />

  <article class="fade-in" style="padding: 3rem 0; max-width: 800px; margin: 0 auto;">
    <p><a href={`${import.meta.env.BASE_URL}/work/`}>&larr; Back to Work</a></p>
    <h1>{title}</h1>
    <p style="color: var(--text-dim);">
      {year}
      {medium && ` · ${medium}`}
      {dimensions && dimensions !== '—' && ` · ${dimensions}`}
    </p>
    <div style="position:relative;" data-detail-zoom>
      <a
        href={img.src}
        data-pswp-src={img.src}
        data-pswp-width={img.width || 1600}
        data-pswp-height={img.height || 2000}
        aria-label={`Zoom in on ${title}`}
        style="display:block; cursor: zoom-in;"
      >
      {img.format === 'svg' ? (
        <img
          src={img.src}
          alt={alt}
          style="width:100%; border-radius: 12px; border: 1px solid rgba(143,184,255,0.2); box-shadow: 0 0 60px rgba(168,216,255,0.08); display:block;"
        />
      ) : (
        <Image
          src={img}
          alt={alt}
          widths={[480, 800, 1200, 1600]}
          sizes="(max-width: 800px) 92vw, 800px"
          format="webp"
          quality={82}
          style="width:100%; border-radius: 12px; border: 1px solid rgba(143,184,255,0.2); box-shadow: 0 0 60px rgba(168,216,255,0.08); display:block;"
        />
      )}
      </a>
      {hasSignature && (
        <img
          src={`${base}/images/studio/signature.png`}
          alt="Signed by the artist"
          style={sigStyle}
        />
      )}
    </div>
    {description && <p style="margin-top: 1.5rem; max-width: 640px;">{description}</p>}
  </article>

  <script>
    import PhotoSwipeLightbox from 'photoswipe/lightbox';
    const zoomHost = document.querySelector('[data-detail-zoom]');
    if (zoomHost) {
      const lightbox = new PhotoSwipeLightbox({
        gallery: zoomHost,
        children: 'a[data-pswp-src]',
        pswpModule: () => import('photoswipe'),
        padding: { top: 40, bottom: 40, left: 20, right: 20 },
        zoom: true,
        maxZoomLevel: 4,
      });
      lightbox.init();
    }
  </script>
</Base>
