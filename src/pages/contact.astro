---
import Base from '../layouts/Base.astro';

/* Contact form delivery: FormSubmit (no account, no API key).
   Messages go straight to Sarah's inbox. The very first submission
   asks Sarah to click one activation link; everything after just works. */
const RECIPIENT = 's.blachly2023@gmail.com';
---

<Base title="Contact" description="Contact Sarah Blachly about commissions or purchasing artwork.">
  <section class="fade-in" style="padding: 3rem 0; max-width: 560px; margin: 0 auto;">
    <h1>Contact</h1>
    <p style="color: var(--text-dim);">For commissions, purchases, or just to say hello — messages come straight to Sarah, privately.</p>
    <form id="contact-form" action={`https://formsubmit.co/${RECIPIENT}`} method="POST" style="display:flex; flex-direction:column; gap:1rem; margin-top:2rem;">
      <input type="text" name="_honey" style="display:none;" tabindex="-1" autocomplete="off" />
      <input type="hidden" name="_subject" value="New inquiry from your website" />
      <input type="hidden" name="_template" value="table" />
      <input type="hidden" name="_captcha" value="false" />
      <label>
        Name
        <input type="text" name="name" required placeholder="Your name" />
      </label>
      <label>
        Email
        <input type="email" name="email" required placeholder="you@example.com" />
      </label>
      <label>
        I'm interested in
        <select name="interest">
          <option value="commission">A commission</option>
          <option value="purchase">Purchasing an artwork</option>
          <option value="other">Something else</option>
        </select>
      </label>
      <label>
        Message
        <textarea name="message" rows="5" required placeholder="Tell Sarah about your idea..."></textarea>
      </label>
      <button class="btn" type="submit" data-send>Send Message</button>
      <p data-status role="status" style="min-height:1.5em; color: var(--text-dim);"></p>
    </form>
    <p style="color: var(--text-dim); font-size: 0.9rem; margin-top: 2rem;"><em>Social links will appear here when ready.</em></p>
  </section>

  <script define:vars={{ recipient: RECIPIENT }}>
    (function () {
      const form = document.getElementById('contact-form');
      const status = form.querySelector('[data-status]');
      const sendBtn = form.querySelector('[data-send]');
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        status.textContent = 'Sending…';
        sendBtn.disabled = true;
        const data = Object.fromEntries(new FormData(form).entries());
        try {
          const res = await fetch(`https://formsubmit.co/ajax/${recipient}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify(data),
          });
          if (!res.ok) throw new Error('the service answered ' + res.status);
          status.textContent = 'Sent — thank you! Sarah will reply soon.';
          form.reset();
        } catch (err) {
          status.innerHTML = 'Something hiccuped sending that. Please email Sarah directly at ' +
            `<a href="mailto:${recipient}">${recipient}</a>.`;
        } finally {
          sendBtn.disabled = false;
        }
      });
    })();
  </script>

  <style>
    #contact-form label { display: flex; flex-direction: column; gap: 0.4rem; color: var(--text); }
    #contact-form input, #contact-form textarea, #contact-form select {
      font-family: var(--sans);
      padding: 0.7rem;
      border: 1px solid rgba(143, 184, 255, 0.25);
      border-radius: 8px;
      background: rgba(10, 18, 38, 0.6);
      color: var(--text);
    }
    #contact-form input:focus, #contact-form textarea:focus, #contact-form select:focus {
      outline: none;
      border-color: var(--prism-1);
      box-shadow: 0 0 16px rgba(168, 216, 255, 0.2);
    }
    #contact-form .btn:disabled { opacity: 0.6; cursor: wait; }
  </style>
</Base>
