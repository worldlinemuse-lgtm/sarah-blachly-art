---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---

<Base title="Lost in the forest" description="This page wandered off the path — find your way back to Sarah Blachly's gallery.">
  <section class="fade-in" style="text-align:center; padding: 5rem 1rem 6rem; max-width: 560px; margin: 0 auto;">
    <div aria-hidden="true" style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.7;">✦</div>
    <h1>Lost in the forest</h1>
    <p style="color: var(--text-dim); font-size: 1.05rem; margin: 1rem 0 2rem;">
      This page wandered off the path. The gallery is still here —<br />let the fireflies guide you back.
    </p>
    <div style="display:flex; gap: 0.8rem; justify-content: center; flex-wrap: wrap;">
      <a class="btn" href={`${base}/work/`}>Enter the Gallery</a>
      <a class="btn" href={`${base}/about/`} style="background: transparent; border: 1px solid rgba(143,184,255,0.35);">About Sarah</a>
      <a class="btn" href={`${base}/contact/`} style="background: transparent; border: 1px solid rgba(143,184,255,0.35);">Contact</a>
    </div>
  </section>
</Base>
