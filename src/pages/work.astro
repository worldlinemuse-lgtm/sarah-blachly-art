---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';

const artworks = await getCollection('artworks');
const seriesList = await getCollection('series');
const base = import.meta.env.BASE_URL;

function slugOf(id: string) { return id.replace(/\.md$/, ''); }

// Group artworks by series; uncategorized go last under "Miscellaneous"
const bySeries = new Map<string, typeof artworks>();
for (const a of artworks) {
  const key = a.data.series || 'miscellaneous';
  if (!bySeries.has(key)) bySeries.set(key, []);
  bySeries.get(key)!.push(a);
}
const orderedSeries = [
  ...seriesList,
  ...[...bySeries.keys()]
    .filter((k) => !seriesList.some((s) => slugOf(s.id) === k))
    .map((k) => ({ id: k + '.md', data: { title: k } })),
];
---

<Base title="Work" description="Browse Sarah Blachly's art portfolio by category: Dragons, Abstract, Characters & OCs, Painting, and more.">
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Work — Sarah Blachly",
    "description": "Browse Sarah Blachly's art portfolio by category.",
    "url": "https://worldlinemuse-lgtm.github.io/sarah-blachly-art/work/",
  })} />
  <link rel="stylesheet" href="https://unpkg.com/photoswipe@5/dist/photoswipe.css" />

  <section class="fade-in" style="padding: 3rem 0;">
    <h1 style="text-align:center;">Work</h1>
    <p style="text-align:center; color: var(--text-dim); max-width:560px; margin:0 auto 1rem;">
      Click any piece to view it full-screen — arrow keys or swipe to move between works.
    </p>
    <p class="zoom-tip">Tip: click or pinch to zoom into brushwork.</p>
    <div class="filter-pills" role="group" aria-label="Filter by series">
      <button type="button" class="filter-pill is-active" data-filter="all">All</button>
      {orderedSeries.filter((s) => bySeries.has(slugOf(s.id))).map((s) => (
        <button type="button" class="filter-pill" data-filter={slugOf(s.id)}>{s.data.title}</button>
      ))}
    </div>

    {orderedSeries.filter((s) => bySeries.has(slugOf(s.id))).map((s) => {
      const key = slugOf(s.id);
      const items = [...bySeries.get(key)!].sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
      return (
        <section id={key} data-studio-series={key} style="margin-bottom: 3.5rem;">
          <h2 data-studio-series-title={key} style="border-bottom: 1px solid rgba(143,184,255,0.15); padding-bottom: 0.5rem;">{s.data.title}</h2>
          {s.data.description && <p style="color: var(--text-dim);">{s.data.description}</p>}
          <div class="gallery-grid" data-gallery>
            {items.map((a) => {
              const aslug = slugOf(a.id);
              return (
                <a
                  class="art-card"
                  data-studio-card={aslug}
                  href={`${base}/work/${aslug}/`}
                  data-pswp-src={a.data.image.src}
                  data-pswp-width={a.data.image.width || 1600}
                  data-pswp-height={a.data.image.height || 2000}
                  data-details-url={`${base}/work/${aslug}/`}
                  data-title={`${a.data.title} (${a.data.year})`}
                >
                  {a.data.image.format === 'svg' ? (
                    <img src={a.data.image.src} alt={a.data.alt} loading="lazy" />
                  ) : (
                    <Image
                      src={a.data.image}
                      alt={a.data.alt}
                      widths={[480, 800, 1200, 1600]}
                      sizes="(max-width: 700px) 90vw, 800px"
                      format="webp"
                      quality={82}
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                  <div class="art-meta">
                    <strong>{a.data.title}</strong>
                    <span>{a.data.year}{a.data.medium && ` · ${a.data.medium}`}</span>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      );
    })}
  </section>

  <!-- Artwork index for the Studio (drag to arrange) -->
  <script type="application/json" id="studio-artwork-index" set:html={JSON.stringify(artworks.map((a) => ({
    slug: slugOf(a.id),
    file: `src/content/artworks/${a.id}`,
    title: a.data.title,
    series: a.data.series || 'miscellaneous',
    order: a.data.order || 0,
  })))} />

  <style>
    .zoom-tip {
      text-align: center;
      color: var(--text-dim);
      font-size: 0.85rem;
      font-style: italic;
      margin: 0 auto 1.5rem;
      opacity: 0.85;
    }
    .filter-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      justify-content: center;
      margin-bottom: 2.5rem;
    }
    .filter-pill {
      font-family: var(--sans);
      font-size: 0.9rem;
      color: var(--text-dim);
      background: rgba(10, 18, 38, 0.5);
      border: 1px solid rgba(143, 184, 255, 0.18);
      border-radius: 999px;
      padding: 0.45rem 1.1rem;
      cursor: pointer;
      transition: color 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.3s ease;
    }
    .filter-pill:hover {
      color: var(--star);
      border-color: rgba(168, 216, 255, 0.5);
      box-shadow: 0 0 16px rgba(168, 216, 255, 0.12);
    }
    .filter-pill.is-active {
      color: #0a1226;
      font-weight: 600;
      background: linear-gradient(135deg, var(--prism-1), var(--prism-2));
      border-color: transparent;
      box-shadow: 0 0 20px rgba(168, 216, 255, 0.25);
    }
    .gallery-grid {
      columns: 260px;
      column-gap: 1.5rem;
    }
    .art-card {
      display: inline-block;
      width: 100%;
      break-inside: avoid;
      margin-bottom: 1.5rem;
      border: 1px solid rgba(143, 184, 255, 0.18);
      border-radius: 12px;
      overflow: hidden;
      background: rgba(10, 18, 38, 0.5);
      transition: transform 0.3s ease, box-shadow 0.4s ease, border-color 0.4s ease;
    }
    @keyframes breathe {
      0%, 100% { transform: translateY(-4px) scale(1); }
      50% { transform: translateY(-4px) scale(1.015); }
    }
    .art-card:hover {
      text-decoration: none;
      border-color: rgba(168, 216, 255, 0.5);
      box-shadow:
        0 8px 40px rgba(168, 216, 255, 0.15),
        0 0 32px rgba(168, 255, 216, 0.22),
        0 0 64px rgba(216, 184, 255, 0.10);
      animation: breathe 4s ease-in-out infinite;
    }
    @media (prefers-reduced-motion: reduce) {
      .art-card:hover { animation: none; transform: translateY(-4px); }
    }
    .art-card img { width: 100%; height: auto; display: block; }
    .art-meta { padding: 0.8rem 1rem; display: flex; flex-direction: column; gap: 0.2rem; }
    .art-meta strong { color: var(--star); font-family: var(--serif); font-size: 1.05rem; }
    .art-meta span { color: var(--text-dim); font-size: 0.85rem; }
    .pswp__details-link {
      color: #fff; font-size: 14px; padding: 8px 12px;
      background: rgba(143,184,255,0.15); border: 1px solid rgba(143,184,255,0.4);
      border-radius: 999px; cursor: pointer; text-decoration: none;
    }
  </style>

  <script>
    import PhotoSwipeLightbox from 'photoswipe/lightbox';
    document.querySelectorAll('[data-gallery]').forEach((galleryEl) => {
      const lightbox = new PhotoSwipeLightbox({
        gallery: galleryEl,
        children: 'a.art-card',
        pswpModule: () => import('photoswipe'),
        padding: { top: 40, bottom: 40, left: 20, right: 20 },
        zoom: true,
        allowPanToNext: true,
        maxZoomLevel: 4,
      });
      lightbox.on('uiRegister', () => {
        lightbox.pswp.ui.registerElement({
          name: 'details-link',
          order: 9,
          isButton: true,
          html: '<span class="pswp__details-link">Artwork details</span>',
          onClick: () => {
            const url = lightbox.pswp.currSlide?.data?.element?.dataset?.detailsUrl;
            if (url) window.location.href = url;
          },
        });
      });
      lightbox.init();
    });

    // Series filter pills: show only the chosen series section, "All" shows everything
    const pills = document.querySelectorAll('.filter-pill');
    const sections = document.querySelectorAll('section[data-studio-series]');
    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        pills.forEach((p) => p.classList.remove('is-active'));
        pill.classList.add('is-active');
        const filter = pill.dataset.filter;
        sections.forEach((section) => {
          section.hidden = filter !== 'all' && section.dataset.studioSeries !== filter;
        });
      });
    });
  </script>
</Base>
