---
import Base from '../layouts/Base.astro';
---

<Base title="Work" description="Browse Sarah Blachly's artwork by series.">
  <section class="fade-in" style="padding: 3rem 0;">
    <h1 style="text-align:center;">Work</h1>
    <p style="text-align:center; color: var(--text-dim); max-width:560px; margin:0 auto 3rem;">
      <em>Artwork organized by series will appear here. Each piece opens into its own page.</em>
    </p>
    <div id="gallery" style="display:grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.5rem;">
      <!-- Artwork cards render here from the CMS -->
    </div>
  </section>
</Base>
