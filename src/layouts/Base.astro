---
import '../styles/global.css';
import siteSettings from '../content/settings/site.json';
import fs from 'node:fs';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Art portfolio of Sarah Blachly — self-taught artist.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const c = siteSettings.colors;
const hasPaintedBg = fs.existsSync('public/images/studio/background.png');
const hasSignature = fs.existsSync('public/images/studio/signature.png');
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | Sarah Blachly — Art Portfolio</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  <link rel="stylesheet" href={`${base}/studio/studio.css`} />
  <style define:vars={{ nightBlue: c.nightBlue, purpleGlow: c.purpleGlow, forestGreen: c.forestGreen }}>
    body {
      background:
        radial-gradient(1200px 800px at 70% -10%, color-mix(in srgb, var(--purpleGlow) 35%, transparent), transparent 60%),
        radial-gradient(900px 700px at 15% 10%, color-mix(in srgb, var(--nightBlue) 50%, transparent), transparent 60%),
        radial-gradient(1000px 900px at 50% 110%, color-mix(in srgb, var(--forestGreen) 45%, transparent), transparent 60%),
        linear-gradient(180deg, var(--night-0) 0%, #0a1226 45%, var(--forestGreen) 100%);
    }
  </style>
</head>
<body data-studio-base={base}>
  <div class="nebula" aria-hidden="true"></div>
  <div class="milky-way" aria-hidden="true"></div>
  <div class="stars" id="stars" aria-hidden="true"></div>

  <div class="wrap">
    <nav class="site-nav" aria-label="Main navigation">
      <a class="brand" href={`${base}/`}>Sarah Blachly</a>
      <ul>
        <li><a href={`${base}/work/`}>Work</a></li>
        <li><a href={`${base}/about/`}>About</a></li>
        <li><a href={`${base}/whiteboard/`}>Whiteboard</a></li>
        <li><a href={`${base}/process/`}>Process</a></li>
        <li><a href={`${base}/contact/`}>Contact</a></li>
      </ul>
    </nav>

    <main>
      <slot />
    </main>

    <footer>
      {siteSettings.commissionsOpen && (
        <p class="commissions-banner">{siteSettings.commissionsMessage} — <a href={`${base}/contact/`}>get in touch</a></p>
      )}
      <p>&copy; <span id="year"></span> Sarah Blachly. All artwork &copy; the artist.</p>
      <p style="margin-top:0.6rem;"><a href="#" data-studio-enter style="font-size:0.8rem; opacity:0.6;">Studio</a></p>
    </footer>
  </div>

  <!-- Sarah's own painted background, when she makes one -->
  {hasPaintedBg && (
    <div class="studio-painted-bg" aria-hidden="true" style={`background-image:url(${base}/images/studio/background.png)`}></div>
  )}
  <style>
    .studio-painted-bg {
      position: fixed;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      background-size: cover;
      background-position: center;
    }
  </style>

  <style>
    .commissions-banner {
      font-family: var(--serif);
      font-size: 1.2rem;
      color: var(--star);
      text-shadow: 0 0 24px rgba(255, 200, 150, 0.25);
      margin-bottom: 1rem;
    }
    /* Wispy vine — a delicate luminous tendril climbing the bottom of the page
       and up the right side. Pure background depth: never interactive. */
    .wispy-vine {
      position: fixed;
      left: 0; right: 0; bottom: 0;
      height: min(38vh, 340px);
      width: 100%;
      z-index: 1;
      pointer-events: none;
      opacity: 0.55;
    }
    @media (prefers-reduced-motion: reduce) {
      .wispy-vine .drift { animation: none; }
    }
    .wispy-vine .drift {
      animation: vine-sway 14s ease-in-out infinite alternate;
      transform-origin: bottom center;
    }
    @keyframes vine-sway {
      from { transform: translateX(-6px); }
      to { transform: translateX(6px); }
    }
  </style>
  <svg class="wispy-vine" viewBox="0 0 1440 340" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
    <defs>
      <linearGradient id="vineA" x1="0" y1="1" x2="1" y2="0">
        <stop offset="0" stop-color="#a8d8ff" stop-opacity="0"/>
        <stop offset="0.45" stop-color="#a8d8ff" stop-opacity="0.28"/>
        <stop offset="0.8" stop-color="#d8b8ff" stop-opacity="0.42"/>
        <stop offset="1" stop-color="#d8b8ff" stop-opacity="0"/>
      </linearGradient>
      <linearGradient id="vineB" x1="1" y1="1" x2="1" y2="0">
        <stop offset="0" stop-color="#a8ffd8" stop-opacity="0"/>
        <stop offset="0.5" stop-color="#a8ffd8" stop-opacity="0.3"/>
        <stop offset="1" stop-color="#a8d8ff" stop-opacity="0.45"/>
      </linearGradient>
      <radialGradient id="budGlow">
        <stop offset="0" stop-color="#eaf4ff" stop-opacity="0.9"/>
        <stop offset="0.4" stop-color="#a8d8ff" stop-opacity="0.35"/>
        <stop offset="1" stop-color="#a8d8ff" stop-opacity="0"/>
      </radialGradient>
    </defs>
    <g class="drift" fill="none" stroke-linecap="round">
      <!-- tendrils wandering along the bottom -->
      <path d="M-40,340 C180,322 260,286 430,308 S700,336 880,306 S1180,272 1480,322"
            stroke="url(#vineA)" stroke-width="1.6"/>
      <path d="M-40,340 C140,330 220,312 360,322 S620,340 780,322"
            stroke="url(#vineB)" stroke-width="1.1" opacity="0.7"/>
      <path d="M240,340 C300,300 280,270 340,250 S420,240 430,200"
            stroke="url(#vineA)" stroke-width="1.2" opacity="0.8"/>
      <path d="M700,340 C740,310 730,290 780,275 S850,265 860,230"
            stroke="url(#vineB)" stroke-width="1" opacity="0.7"/>
      <!-- the climbing vine, up the right side -->
      <path d="M1330,340 C1310,260 1370,230 1345,150 S1320,70 1365,-10"
            stroke="url(#vineA)" stroke-width="1.8"/>
      <path d="M1330,340 C1290,280 1240,260 1255,200 S1290,150 1270,110"
            stroke="url(#vineB)" stroke-width="1.1" opacity="0.75"/>
      <path d="M1345,150 C1380,140 1400,120 1395,95"
            stroke="url(#vineA)" stroke-width="1" opacity="0.7"/>
      <!-- curls -->
      <path d="M430,308 c26,-4 30,-34 8,-40 c-18,-5 -30,12 -18,24"
            stroke="url(#vineB)" stroke-width="1" opacity="0.8"/>
      <path d="M880,306 c-24,-6 -26,-34 -6,-38 c16,-3 26,14 15,25"
            stroke="url(#vineA)" stroke-width="1" opacity="0.8"/>
      <path d="M1345,150 c20,-8 22,-32 4,-36 c-15,-3 -24,13 -13,23"
            stroke="url(#vineB)" stroke-width="1" opacity="0.8"/>
    </g>
    <g fill="url(#budGlow)">
      <circle cx="340" cy="250" r="7"/>
      <circle cx="430" cy="200" r="5"/>
      <circle cx="780" cy="275" r="6"/>
      <circle cx="860" cy="230" r="4.5"/>
      <circle cx="1255" cy="200" r="6"/>
      <circle cx="1395" cy="95" r="5"/>
      <circle cx="180" cy="318" r="4"/>
      <circle cx="1050" cy="296" r="4.5"/>
    </g>
  </svg>

  <script>
    // Star field: quiet fairy dust — moon white, prism blue, lilac, mint,
    // with rare warm gold embers. Softer at the top, a little stronger below.
    (function () {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const container = document.getElementById('stars');
      const palette = [
        [234, 242, 255],  // moon white
        [200, 222, 255],  // starlight
        [168, 216, 255],  // prism blue
        [216, 184, 255],  // fairy lilac
        [168, 255, 216],  // mint glow
        [255, 210, 140],  // gold dust (rare warm)
        [255, 154, 110],  // ember (rarest warm)
      ];
      const weights = [0.24, 0.2, 0.18, 0.14, 0.12, 0.08, 0.04];
      function pickColor() {
        let r = Math.random(), acc = 0;
        for (let i = 0; i < weights.length; i++) {
          acc += weights[i];
          if (r <= acc) return palette[i];
        }
        return palette[0];
      }
      function layer(count, size) {
        const el = document.createElement('div');
        let shadows = [];
        for (let i = 0; i < count; i++) {
          const x = Math.random() * 100;
          const y = Math.random() * 100;
          const [r, g, b] = pickColor();
          // softer at top (y=0), harder at bottom (y=100)
          const opacity = 0.15 + (y / 100) * 0.6;
          shadows.push(`${x}vw ${y}vh 0 ${size}px rgba(${r},${g},${b},${opacity.toFixed(2)})`);
        }
        el.style.cssText = `position:fixed;inset:0;width:${size}px;height:${size}px;border-radius:50%;box-shadow:${shadows.join(',')};`;
        return el;
      }
      container.appendChild(layer(200, 1));
      container.appendChild(layer(110, 2));
      container.appendChild(layer(36, 3));

      // Fade-in on scroll
      const io = new IntersectionObserver((entries) => {
        entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
      }, { threshold: 0.1 });
      document.querySelectorAll('.fade-in').forEach(el => io.observe(el));

      document.getElementById('year').textContent = new Date().getFullYear();
    })();
  </script>

  <!-- The Studio: Sarah's editing world. Dormant until she taps "Studio". -->
  <script type="module">
    const base = document.body.dataset.studioBase;
    const studio = await import(`${base}/studio/studio.js`);
    const drag = await import(`${base}/studio/drag.js`);
    const whiteboard = await import(`${base}/studio/whiteboard.js`);
    const content = await import(`${base}/studio/content.js`);
    const sign = await import(`${base}/studio/sign.js`);
    const add = await import(`${base}/studio/add.js`);
    studio.registerMode('arrange', { enter: drag.enter, exit: drag.exit });
    studio.registerMode('whiteboard', { enter: whiteboard.enter, exit: whiteboard.exit });
    studio.registerMode('content', { enter: content.enter, exit: content.exit });
    studio.registerMode('sign', { enter: sign.enter, exit: sign.exit });
    studio.registerMode('add', { enter: add.enter, exit: add.exit });
  </script>
</body>
</html>
